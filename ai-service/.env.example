# Copy to .env and set real values. NEVER commit the real .env.
# Shared secret the Java backend must present on every request.
AI_SERVICE_TOKEN=change-me-to-a-long-random-value

# Bind address — keep loopback unless the Java backend is on another host.
AI_HOST=127.0.0.1
AI_PORT=8099

# Where trained artifacts are written/read.
# On this dev machine the runtime lives on D: (C: is full):
AI_MODELS_DIR=D:\usamis-ai\models
